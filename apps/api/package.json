    "@nestjs/platform-fastify": "latest",
    "@novavend/config": "workspace:*",
    "@novavend/contracts": "workspace:*",
    "fastify": "latest",
    "nestjs-pino": "latest",
    "pino": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "tsx": "latest"
  }
}
